    <string name="prep_tip_yahtzee_5">Quand deux options se valent, choisis celle qui laisse le plus de flexibilité au lancer suivant.</string>
    <string name="prep_tip_custom_1">Commence par les règles à valeur fixe pour sécuriser un socle de points.</string>
    <string name="prep_tip_custom_2">Si une règle custom est risquée, attends un lancer naturellement favorable.</string>
